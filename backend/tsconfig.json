{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "../dist/backend",
    "rootDir": "..",
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["./src/*"],
      "@shared/*": ["../shared/types/*"]
    },
    "noEmit": false
  },
  "include": ["src/**/*", "../shared/types/**/*"]
}
