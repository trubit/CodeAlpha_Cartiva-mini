# ==============================================================================
# CARTIVA MINI — UNIFIED ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Phase 1: Planning Template (Documentation / Reference Only)
# NOTE: Never store real secrets or production credentials in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & SERVER CONFIGURATION (Backend Only)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# 2. CORS & NETWORKING CONFIGURATION (Backend Only)
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5180
BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (Backend Only - SENSITIVE)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/cartiva-mini

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION SECRETS (Backend Only - SENSITIVE)
# Generate cryptographically strong random strings (e.g. openssl rand -base64 48)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_characters_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# 5. PAYSTACK PAYMENT GATEWAY CONFIGURATION
# PAYSTACK_SECRET_KEY: SENSITIVE - Backend Only
# PAYSTACK_PUBLIC_KEY: Public - Allowed on client via VITE_ prefix
# ------------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_or_same_as_secret_key
PAYSTACK_BASE_URL=https://api.paystack.co

# ------------------------------------------------------------------------------
# 6. CLOUDINARY MEDIA ASSET STORAGE
# CLOUDINARY_API_SECRET: SENSITIVE - Backend Only
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL EMAIL & NOTIFICATIONS (Backend Only - SENSITIVE)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=Cartiva Mini <noreply@cartivamini.com>
ADMIN_EMAIL=admin@cartivamini.com

# Optional SMS Integration Boundary (Channel currently marked unavailable)
# SMS_PROVIDER=termii
# SMS_API_KEY=your_termii_api_key
# SMS_SENDER_ID=CartivaMini

# Optional Web Push Integration Boundary (Channel currently marked unavailable)
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_SUBJECT=mailto:admin@cartivamini.com

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT CONFIGURATION (Vite Client Ingestion)
# Variables accessible to the browser bundle MUST start with VITE_
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
